<UserControl x:Class="Nethesap.UI.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Nethesap.UI.Views"
             xmlns:viewModels="clr-namespace:Nethesap.UI.ViewModels"
             xmlns:converters="clr-namespace:Nethesap.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=viewModels:SalesViewModel}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header with Add Button -->
        <DockPanel Grid.Row="0" Margin="0 0 0 16">
            <Button DockPanel.Dock="Right"
                    Command="{Binding AddSaleCommand}"
                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                    Background="{StaticResource PrimaryHueDarkBrush}"
                    BorderBrush="{StaticResource PrimaryHueDarkBrush}"
                    ToolTip="Yeni Satış Ekle">
                <materialDesign:PackIcon Kind="CartPlus" Height="24" Width="24"/>
            </Button>
            <TextBlock Text="Satışlar"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       VerticalAlignment="Center"/>
        </DockPanel>
        
        <!-- Filter Section -->
        <Grid Grid.Row="1" Margin="0 0 0 16">
            <materialDesign:Card Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                              Text="Satış Filtreleme" 
                              Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                              Margin="0 0 0 16"/>
                    
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Start Date -->
                        <DatePicker Grid.Column="0"
                                  SelectedDate="{Binding StartDate}"
                                  materialDesign:HintAssist.Hint="Başlangıç Tarihi"
                                  Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                  Margin="0 0 8 0"/>
                        
                        <!-- End Date -->
                        <DatePicker Grid.Column="1"
                                  SelectedDate="{Binding EndDate}"
                                  materialDesign:HintAssist.Hint="Bitiş Tarihi"
                                  Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                  Margin="8 0 8 0"/>
                        
                        <!-- Payment Method -->
                        <ComboBox Grid.Column="2"
                                 ItemsSource="{Binding PaymentMethods}"
                                 SelectedItem="{Binding FilterPaymentMethod}"
                                 materialDesign:HintAssist.Hint="Ödeme Yöntemi"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 Margin="8 0 8 0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="Cash">
                                                        <Setter Property="Text" Value="Nakit"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="CreditCard">
                                                        <Setter Property="Text" Value="Kredi Kartı"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="BankTransfer">
                                                        <Setter Property="Text" Value="Havale"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                        <!-- Filter Button -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8 0 0 0">
                            <Button Command="{Binding FilterSalesCommand}"
                                  Style="{StaticResource MaterialDesignRaisedButton}"
                                  Content="Filtrele"
                                  Margin="0 0 8 0"/>
                            
                            <Button Command="{Binding ResetFilterCommand}"
                                  Style="{StaticResource MaterialDesignOutlinedButton}"
                                  Content="Sıfırla"
                                  Margin="0 0 8 0"/>
                            
                            <Button Command="{Binding GenerateReportCommand}"
                                  Style="{StaticResource MaterialDesignOutlinedButton}"
                                  ToolTip="Satış Raporu Oluştur">
                                <materialDesign:PackIcon Kind="FileChart" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
        
        <!-- Sales DataGrid -->
        <materialDesign:Card Grid.Row="2" UniformCornerRadius="4">
            <DataGrid ItemsSource="{Binding FilteredSales}"
                     SelectedItem="{Binding SelectedSale}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                     materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Müşteri" Width="*">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Customer.FirstName" />
                                <Binding Path="Customer.LastName" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tarih" 
                                      Binding="{Binding CreatedDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                      Width="*"/>
                    <DataGridTextColumn Header="Ödeme Yöntemi" 
                                      Width="*">
                        <DataGridTextColumn.Binding>
                            <Binding Path="PaymentMethod">
                                <Binding.Converter>
                                    <converters:PaymentMethodConverter/>
                                </Binding.Converter>
                            </Binding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tür"
                                      Width="*">
                        <DataGridTextColumn.Binding>
                            <Binding Path="PaymentType">
                                <Binding.Converter>
                                    <converters:PaymentTypeConverter/>
                                </Binding.Converter>
                            </Binding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tutar" 
                                      Binding="{Binding TotalAmount, StringFormat={}{0:C2}}"
                                      Width="*"/>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.RefundSaleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}"
                                      Style="{StaticResource MaterialDesignIconButton}"
                                      ToolTip="İade Et"
                                      Visibility="{Binding PaymentType, Converter={StaticResource PaymentTypeToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="CartRemove" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ViewSaleDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}"
                                      Style="{StaticResource MaterialDesignIconButton}"
                                      ToolTip="Detaylar">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
        
        <!-- New Sale Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3" 
                                 IsOpen="{Binding IsNewSaleDialogOpen}" 
                                 CloseOnClickAway="False">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="700" MinHeight="500">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Dialog Title -->
                    <TextBlock Grid.Row="0" 
                             Text="Yeni Satış" 
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Margin="16 16 16 16"/>
                    
                    <!-- Customer Selection -->
                    <Grid Grid.Row="1" Margin="16 0 16 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox Grid.Column="0"
                               Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                               materialDesign:HintAssist.Hint="Müşteri Ara"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        
                        <ComboBox Grid.Column="1"
                                 ItemsSource="{Binding Customers}"
                                 SelectedItem="{Binding SelectedCustomer}"
                                 materialDesign:HintAssist.Hint="Müşteri Seç"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 Width="200"
                                 Margin="16 0 0 0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding FirstName}"/>
                                        <Run Text="{Binding LastName}"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding Phone}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    
                    <!-- Product Selection -->
                    <Grid Grid.Row="2" Margin="16 0 16 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox Grid.Column="0"
                               Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                               materialDesign:HintAssist.Hint="Ürün Ara"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchProductCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        
                        <TextBox Grid.Column="1"
                               Text="{Binding Quantity}"
                               materialDesign:HintAssist.Hint="Miktar"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Width="100"
                               Margin="16 0 16 0"/>
                        
                        <Button Grid.Column="2"
                              Command="{Binding AddProductToSaleCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="Ekle"/>
                    </Grid>
                    
                    <!-- Product Search Popup -->
                    <Popup IsOpen="{Binding IsProductSearchOpen}" 
                         PlacementTarget="{Binding ElementName=ProductSearchBox}" 
                         Placement="Bottom" 
                         Width="400" 
                         MaxHeight="300"
                         StaysOpen="False">
                        <materialDesign:Card>
                            <ListView ItemsSource="{Binding Products}"
                                    SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Description}" Opacity="0.7"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" 
                                                     Text="{Binding Price, StringFormat={}{0:C2}}"
                                                     VerticalAlignment="Center"/>
                                            <Grid.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" 
                                                           Command="{Binding DataContext.SelectProductCommand, 
                                                                    RelativeSource={RelativeSource AncestorType=ListView}}"
                                                           CommandParameter="{Binding}"/>
                                            </Grid.InputBindings>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </materialDesign:Card>
                    </Popup>
                    
                    <!-- Cart Items -->
                    <DataGrid Grid.Row="3"
                           ItemsSource="{Binding CurrentSaleItems}"
                           SelectedItem="{Binding SelectedSaleItem}"
                           Margin="16 0 16 16"
                           AutoGenerateColumns="False"
                           IsReadOnly="True"
                           CanUserAddRows="False"
                           CanUserDeleteRows="False"
                           materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                           materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ürün" Binding="{Binding Product.Name}" Width="*"/>
                            <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity}" Width="Auto"/>
                            <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, StringFormat={}{0:C2}}" Width="Auto"/>
                            <DataGridTextColumn Header="Toplam" Binding="{Binding TotalPrice, StringFormat={}{0:C2}}" Width="Auto"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveProductFromSaleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              Style="{StaticResource MaterialDesignIconButton}"
                                              ToolTip="Kaldır">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- Payment Method -->
                    <Grid Grid.Row="4" Margin="16 0 16 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                 Text="Ödeme Yöntemi:" 
                                 VerticalAlignment="Center"
                                 Margin="0 0 16 0"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="Nakit" 
                                       IsChecked="{Binding CurrentSale.PaymentMethod, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Cash}"
                                       Style="{StaticResource MaterialDesignRadioButton}"
                                       Margin="0 0 16 0"/>
                            
                            <RadioButton Content="Kredi Kartı" 
                                       IsChecked="{Binding CurrentSale.PaymentMethod, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CreditCard}"
                                       Style="{StaticResource MaterialDesignRadioButton}"
                                       Margin="0 0 16 0"/>
                            
                            <RadioButton Content="Havale" 
                                       IsChecked="{Binding CurrentSale.PaymentMethod, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=BankTransfer}"
                                       Style="{StaticResource MaterialDesignRadioButton}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="Toplam:" 
                                     VerticalAlignment="Center"
                                     Margin="0 0 8 0"/>
                            
                            <TextBlock Text="{Binding CurrentSale.TotalAmount, StringFormat={}{0:C2}}" 
                                     VerticalAlignment="Center"
                                     FontWeight="Bold"
                                     FontSize="18"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="5" 
                              Orientation="Horizontal" 
                              HorizontalAlignment="Right"
                              Margin="16">
                        <Button Command="{Binding CancelSaleCommand}"
                              Style="{StaticResource MaterialDesignOutlinedButton}"
                              Content="İptal"
                              Margin="0 0 8 0"/>
                        
                        <Button Command="{Binding SaveSaleCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="Satışı Tamamla"/>
                    </StackPanel>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
        
        <!-- Refund Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3"
                                 IsOpen="{Binding IsRefundDialogOpen}"
                                 CloseOnClickAway="False">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="400" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0"
                             Text="Satış İadesi"
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Margin="0 0 0 16"/>
                    
                    <TextBlock Grid.Row="1"
                             Margin="0 0 0 16">
                        <Run Text="Müşteri: "/>
                        <Run Text="{Binding SelectedSale.Customer.FirstName}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding SelectedSale.Customer.LastName}"/>
                    </TextBlock>
                    
                    <TextBlock Grid.Row="2"
                             Margin="0 0 0 16">
                        <Run Text="İade Tutarı: "/>
                        <Run Text="{Binding SelectedSale.TotalAmount, StringFormat={}{0:C2}}" FontWeight="Bold"/>
                    </TextBlock>
                    
                    <StackPanel Grid.Row="3"
                              Orientation="Horizontal"
                              HorizontalAlignment="Right">
                        <Button Command="{Binding CancelRefundCommand}"
                              Style="{StaticResource MaterialDesignOutlinedButton}"
                              Content="İptal"
                              Margin="0 0 8 0"/>
                        
                        <Button Command="{Binding ProcessRefundCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="İade Et"/>
                    </StackPanel>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
        
        <!-- Sale Details Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3" 
                                 IsOpen="{Binding IsSaleDetailsDialogOpen}" 
                                 CloseOnClickAway="True">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="700" MinHeight="400">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Dialog Title -->
                    <TextBlock Grid.Row="0" 
                             Text="Satış Detayları" 
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Margin="16 16 16 16"/>
                    
                    <!-- Sale Information -->
                    <Grid Grid.Row="1" Margin="16 0 16 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Müşteri -->
                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                 Text="Müşteri:" 
                                 FontWeight="Bold"
                                 Margin="0 0 8 8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                 Margin="0 0 16 8">
                            <Run Text="{Binding SelectedSale.Customer.FirstName}"/>
                            <Run Text="{Binding SelectedSale.Customer.LastName}"/>
                        </TextBlock>
                        
                        <!-- Tarih -->
                        <TextBlock Grid.Row="0" Grid.Column="2" 
                                 Text="Tarih:" 
                                 FontWeight="Bold"
                                 Margin="0 0 8 8"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" 
                                 Text="{Binding SelectedSale.CreatedDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" 
                                 Margin="0 0 0 8"/>
                        
                        <!-- Ödeme Yöntemi -->
                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                 Text="Ödeme Yöntemi:" 
                                 FontWeight="Bold"
                                 Margin="0 0 8 8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                 Margin="0 0 16 8">
                            <TextBlock.Text>
                                <Binding Path="SelectedSale.PaymentMethod">
                                    <Binding.Converter>
                                        <converters:PaymentMethodConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Text>
                        </TextBlock>
                        
                        <!-- Ödeme Türü -->
                        <TextBlock Grid.Row="1" Grid.Column="2" 
                                 Text="Ödeme Türü:" 
                                 FontWeight="Bold"
                                 Margin="0 0 8 8"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" 
                                 Margin="0 0 0 8">
                            <TextBlock.Text>
                                <Binding Path="SelectedSale.PaymentType">
                                    <Binding.Converter>
                                        <converters:PaymentTypeConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Text>
                        </TextBlock>
                        
                        <!-- Toplam Tutar -->
                        <TextBlock Grid.Row="2" Grid.Column="0" 
                                 Text="Toplam Tutar:" 
                                 FontWeight="Bold"
                                 Margin="0 0 8 8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" 
                                 Text="{Binding SelectedSale.TotalAmount, StringFormat={}{0:C2}}" 
                                 Margin="0 0 16 8"/>
                    </Grid>
                    
                    <!-- Sale Items -->
                    <DataGrid Grid.Row="2" 
                            ItemsSource="{Binding SelectedSale.PaymentItems}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            Margin="16 0 16 16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ürün" 
                                              Binding="{Binding Product.Name}"
                                              Width="*"/>
                            <DataGridTextColumn Header="Miktar" 
                                              Binding="{Binding Quantity}"
                                              Width="Auto"/>
                            <DataGridTextColumn Header="Birim Fiyat" 
                                              Binding="{Binding UnitPrice, StringFormat={}{0:C2}}"
                                              Width="Auto"/>
                            <DataGridTextColumn Header="Toplam" 
                                              Binding="{Binding TotalPrice, StringFormat={}{0:C2}}"
                                              Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- Close Button -->
                    <Button Grid.Row="3" 
                          Command="{Binding CloseSaleDetailsCommand}"
                          Content="Kapat"
                          Style="{StaticResource MaterialDesignFlatButton}"
                          HorizontalAlignment="Right"
                          Margin="16"/>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
    </Grid>
</UserControl> 