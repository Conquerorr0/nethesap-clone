<UserControl x:Class="Nethesap.UI.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Nethesap.UI.Views"
             xmlns:viewModels="clr-namespace:Nethesap.UI.ViewModels"
             xmlns:converters="clr-namespace:Nethesap.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=viewModels:SalesViewModel}">
    
    <UserControl.Resources>
        <converters:PaymentMethodConverter x:Key="PaymentMethodConverter"/>
        <converters:PaymentTypeConverter x:Key="PaymentTypeConverter"/>
        <converters:PaymentTypeToVisibilityConverter x:Key="PaymentTypeToVisibilityConverter"/>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <converters:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header with Add Button -->
        <DockPanel Grid.Row="0" Margin="0 0 0 16">
            <Button DockPanel.Dock="Right"
                    Command="{Binding AddSaleCommand}"
                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                    Background="{StaticResource PrimaryHueDarkBrush}"
                    BorderBrush="{StaticResource PrimaryHueDarkBrush}"
                    ToolTip="Yeni Satış Ekle">
                <materialDesign:PackIcon Kind="CartPlus" Height="24" Width="24"/>
            </Button>
            <TextBlock Text="Satışlar"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       VerticalAlignment="Center"/>
        </DockPanel>
        
        <!-- Filter Section -->
        <Grid Grid.Row="1" Margin="0 0 0 16">
            <materialDesign:Card Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                              Text="Satış Filtreleme" 
                              Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                              Margin="0 0 0 16"/>
                    
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Start Date -->
                        <DatePicker Grid.Column="0"
                                  SelectedDate="{Binding StartDate}"
                                  materialDesign:HintAssist.Hint="Başlangıç Tarihi"
                                  Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                  Margin="0 0 8 0"/>
                        
                        <!-- End Date -->
                        <DatePicker Grid.Column="1"
                                  SelectedDate="{Binding EndDate}"
                                  materialDesign:HintAssist.Hint="Bitiş Tarihi"
                                  Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                  Margin="8 0 8 0"/>
                        
                        <!-- Payment Method -->
                        <ComboBox Grid.Column="2"
                                 ItemsSource="{Binding PaymentMethods}"
                                 SelectedItem="{Binding FilterPaymentMethod}"
                                 materialDesign:HintAssist.Hint="Ödeme Yöntemi"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 Margin="8 0 8 0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="Cash">
                                                        <Setter Property="Text" Value="Nakit"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="CreditCard">
                                                        <Setter Property="Text" Value="Kredi Kartı"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding}" Value="BankTransfer">
                                                        <Setter Property="Text" Value="Havale"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                        <!-- Filter Button -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8 0 0 0">
                            <Button Command="{Binding FilterSalesCommand}"
                                  Style="{StaticResource MaterialDesignRaisedButton}"
                                  Content="Filtrele"
                                  Margin="0 0 8 0"/>
                            
                            <Button Command="{Binding ResetFilterCommand}"
                                  Style="{StaticResource MaterialDesignOutlinedButton}"
                                  Content="Sıfırla"
                                  Margin="0 0 8 0"/>
                            
                            <Button Command="{Binding GenerateReportCommand}"
                                  Style="{StaticResource MaterialDesignOutlinedButton}"
                                  ToolTip="Satış Raporu Oluştur">
                                <materialDesign:PackIcon Kind="FileChart" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
        
        <!-- Sales DataGrid -->
        <materialDesign:Card Grid.Row="2" UniformCornerRadius="4">
            <DataGrid ItemsSource="{Binding FilteredSales}"
                     SelectedItem="{Binding SelectedSale}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                     materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Müşteri" Width="*">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Customer.FirstName" />
                                <Binding Path="Customer.LastName" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tarih" 
                                      Binding="{Binding CreatedDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                      Width="*"/>
                    <DataGridTextColumn Header="Ödeme Yöntemi" 
                                      Width="*">
                        <DataGridTextColumn.Binding>
                            <Binding Path="PaymentMethod">
                                <Binding.Converter>
                                    <converters:PaymentMethodConverter/>
                                </Binding.Converter>
                            </Binding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tür"
                                      Width="*">
                        <DataGridTextColumn.Binding>
                            <Binding Path="PaymentType">
                                <Binding.Converter>
                                    <converters:PaymentTypeConverter/>
                                </Binding.Converter>
                            </Binding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tutar" 
                                      Binding="{Binding TotalAmount, StringFormat='{}{0:N2} TL'}"
                                      Width="*"/>
                    <DataGridTextColumn Header="Ödenen" 
                                      Binding="{Binding PaidAmount, StringFormat='{}{0:N2} TL'}"
                                      Width="*"/>
                    <DataGridTextColumn Header="Kalan" 
                                      Binding="{Binding RemainingAmount, StringFormat='{}{0:N2} TL'}"
                                      Width="*"/>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenPartialPaymentDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}"
                                      ToolTip="Ödeme Yap">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <!-- Varsayılan: Görünsün -->
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <!-- Kalan tutar 0 ise gizle -->
                                                <DataTrigger Binding="{Binding RemainingAmount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="CashMultiple" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ViewPaymentHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}"
                                      Style="{StaticResource MaterialDesignIconButton}"
                                      ToolTip="Ödeme Geçmişi">
                                    <materialDesign:PackIcon Kind="History" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.RefundSaleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}"
                                      Style="{StaticResource MaterialDesignIconButton}"
                                      ToolTip="İade Et"
                                      Visibility="{Binding PaymentType, Converter={StaticResource PaymentTypeToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="CartRemove" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ViewSaleDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}"
                                      Style="{StaticResource MaterialDesignIconButton}"
                                      ToolTip="Detaylar">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
        
        <!-- New Sale Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3" 
                                 IsOpen="{Binding IsNewSaleDialogOpen}" 
                                 CloseOnClickAway="False">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="700" MinHeight="500">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Dialog Title -->
                    <TextBlock Grid.Row="0" 
                             Text="Yeni Satış" 
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Margin="16 16 16 16"/>
                    
                    <!-- Customer Selection -->
                    <Grid Grid.Row="1" Margin="16 0 16 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox Grid.Column="0"
                               x:Name="CustomerSearchBox"
                               Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                               materialDesign:HintAssist.Hint="Müşteri Ara"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               TextChanged="CustomerSearchBox_TextChanged">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCustomerCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        
                        <Button Grid.Column="1"
                              Command="{Binding SearchCustomerCommand}"
                              Style="{StaticResource MaterialDesignIconButton}"
                              ToolTip="Müşteri Ara"
                              Margin="8 0 0 0">
                            <materialDesign:PackIcon Kind="Magnify" />
                        </Button>
                    </Grid>
                    
                    <!-- Customer Search Popup -->
                    <Popup IsOpen="{Binding IsCustomerSearchOpen}" 
                         PlacementTarget="{Binding ElementName=CustomerSearchBox}" 
                         Placement="Bottom" 
                         Width="{Binding ElementName=CustomerSearchBox, Path=ActualWidth}"
                         MaxHeight="400"
                         StaysOpen="False"
                         AllowsTransparency="True">
                        <materialDesign:Card Padding="0" Margin="0">
                            <ListView ItemsSource="{Binding Customers}"
                                    SelectionMode="Single"
                                    MaxHeight="400">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0 0 0 1" BorderBrush="{DynamicResource MaterialDesignDivider}" Padding="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                                         Text="{Binding FirstName, StringFormat='{}{0} '}" 
                                                         FontWeight="Medium">
                                                    <TextBlock.Inlines>
                                                        <Run Text="{Binding LastName}"/>
                                                    </TextBlock.Inlines>
                                                </TextBlock>
                                                
                                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                                         Text="{Binding Phone}" 
                                                         Opacity="0.7"/>
                                                
                                                <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                                      Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                      CommandParameter="{Binding}"
                                                      Content="Seç"
                                                      Style="{StaticResource MaterialDesignFlatButton}"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </materialDesign:Card>
                    </Popup>
                    
                    <!-- Product Selection -->
                    <Grid Grid.Row="2" Margin="16 0 16 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox Grid.Column="0"
                               x:Name="ProductSearchBox"
                               Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                               materialDesign:HintAssist.Hint="Ürün Ara"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               TextChanged="ProductSearchBox_TextChanged">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchProductCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        
                        <Button Grid.Column="1"
                              Command="{Binding SearchProductCommand}"
                              Style="{StaticResource MaterialDesignIconButton}"
                              ToolTip="Ürün Ara"
                              Margin="8 0 0 0">
                            <materialDesign:PackIcon Kind="Magnify" />
                        </Button>
                        
                        <TextBox Grid.Column="2"
                               Text="{Binding Quantity}"
                               materialDesign:HintAssist.Hint="Miktar"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Width="100"
                               Margin="8 0 8 0"/>
                        
                        <Button Grid.Column="3"
                              Command="{Binding AddProductToSaleCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="Ekle"/>
                    </Grid>
                    
                    <!-- Product Search Popup -->
                    <Popup IsOpen="{Binding IsProductSearchOpen}" 
                         PlacementTarget="{Binding ElementName=ProductSearchBox}" 
                         Placement="Bottom" 
                         Width="{Binding ElementName=ProductSearchBox, Path=ActualWidth}"
                         MaxHeight="400"
                         StaysOpen="False"
                         AllowsTransparency="True">
                        <materialDesign:Card Padding="0" Margin="0">
                            <ListView ItemsSource="{Binding Products}"
                                    SelectionMode="Single"
                                    MaxHeight="400">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0 0 0 1" BorderBrush="{DynamicResource MaterialDesignDivider}" Padding="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <TextBlock Grid.Column="0" Grid.Row="0" 
                                                         Text="{Binding Name}" 
                                                         FontWeight="Medium" 
                                                         Margin="0 0 0 4"/>
                                                  
                                                <TextBlock Grid.Column="0" Grid.Row="1" 
                                                          Text="{Binding Description}" 
                                                          TextWrapping="Wrap"
                                                          Opacity="0.7" 
                                                          MaxWidth="300"/>
                                                          
                                                <StackPanel Grid.Row="2" Grid.Column="0" 
                                                           Orientation="Horizontal" 
                                                           Margin="0 4 0 0">
                                                    <TextBlock Text="Stok: " 
                                                              Opacity="0.7"/>
                                                    <TextBlock Text="{Binding StockQuantity}"
                                                              Opacity="0.7"/>
                                                </StackPanel>
                                                 
                                                <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                                                          Text="{Binding Price, StringFormat='{}{0:N2} TL'}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Medium"
                                                           Margin="16 0 0 0"/>
                                                           
                                                <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                                       Command="{Binding DataContext.SelectProductCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                       CommandParameter="{Binding}"
                                                       Content="Seç"
                                                       Style="{StaticResource MaterialDesignFlatButton}"
                                                       VerticalAlignment="Center"
                                                       Margin="8 0 0 0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </materialDesign:Card>
                    </Popup>
                    
                    <!-- Cart Items -->
                    <DataGrid Grid.Row="3"
                           ItemsSource="{Binding CurrentSaleItems}"
                           SelectedItem="{Binding SelectedSaleItem}"
                           Margin="16 0 16 16"
                           AutoGenerateColumns="False"
                           IsReadOnly="True"
                           CanUserAddRows="False"
                           CanUserDeleteRows="False"
                           materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                           materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ürün" Binding="{Binding Product.Name}" Width="*"/>
                            <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity}" Width="Auto"/>
                            <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, StringFormat='{}{0:N2} TL'}" Width="Auto"/>
                            <DataGridTextColumn Header="Toplam" Binding="{Binding TotalPrice, StringFormat='{}{0:N2} TL'}" Width="Auto"/>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveProductFromSaleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}"
                                              Style="{StaticResource MaterialDesignIconButton}"
                                              ToolTip="Kaldır">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- Payment Details -->
                    <Grid Grid.Row="4" Margin="16 8 16 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Total Amount -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Toplam Tutar" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBlock Text="{Binding CurrentSale.TotalAmount, StringFormat='{}{0:C2}', FallbackValue='₺0,00'}" 
                                     FontWeight="Bold" 
                                     FontSize="18"/>
                        </StackPanel>
                        
                        <!-- Paid Amount -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ödenen Tutar" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                                   materialDesign:HintAssist.Hint="Ödenen"
                                   Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                        </StackPanel>
                        
                        <!-- Remaining Amount -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Kalan Tutar" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBlock Text="{Binding RemainingAmount, StringFormat='{}{0:C2}', FallbackValue='₺0,00'}" 
                                     FontWeight="Bold" 
                                     FontSize="18"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="5" 
                              Orientation="Horizontal" 
                              HorizontalAlignment="Right"
                              Margin="16">
                        <Button Command="{Binding CancelSaleCommand}"
                              Style="{StaticResource MaterialDesignOutlinedButton}"
                              Content="İptal"
                              Margin="0 0 8 0"/>
                        
                        <Button Command="{Binding SaveSaleCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="Satışı Tamamla"/>
                    </StackPanel>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
        
        <!-- Refund Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3"
                                 IsOpen="{Binding IsRefundDialogOpen}"
                                 CloseOnClickAway="False">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="400" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0"
                             Text="Satış İadesi"
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Margin="0 0 0 16"/>
                    
                    <TextBlock Grid.Row="1"
                             Margin="0 0 0 16">
                        <Run Text="Müşteri: "/>
                        <Run Text="{Binding SelectedSale.Customer.FirstName}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding SelectedSale.Customer.LastName}"/>
                    </TextBlock>
                    
                    <TextBlock Grid.Row="2"
                             Margin="0 0 0 16">
                        <Run Text="İade Tutarı: "/>
                        <Run Text="{Binding SelectedSale.TotalAmount, StringFormat='{}{0:N2} TL'}" FontWeight="Bold"/>
                    </TextBlock>
                    
                    <StackPanel Grid.Row="3"
                              Orientation="Horizontal"
                              HorizontalAlignment="Right">
                        <Button Command="{Binding CancelRefundCommand}"
                              Style="{StaticResource MaterialDesignOutlinedButton}"
                              Content="İptal"
                              Margin="0 0 8 0"/>
                        
                        <Button Command="{Binding ProcessRefundCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="İade Et"/>
                    </StackPanel>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
        
        <!-- Sale Details Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3" 
                                 IsOpen="{Binding IsSaleDetailsDialogOpen}" 
                                 CloseOnClickAway="True">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="800" MinHeight="500">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Dialog Title -->
                    <DockPanel Grid.Row="0" Margin="24 24 24 16">
                        <materialDesign:PackIcon Kind="Receipt" 
                                               Width="32" Height="32" 
                                               VerticalAlignment="Center" 
                                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="Satış Detayları" 
                                 Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                 Margin="16 0 0 0"
                                 VerticalAlignment="Center"/>
                    </DockPanel>
                    
                    <!-- Sale Summary Card -->
                    <materialDesign:Card Grid.Row="1" Margin="24 0 24 24" Padding="16" UniformCornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/> <!-- Divider -->
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/> <!-- Divider -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Column 1: Customer & Date -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MÜŞTERİ" 
                                         Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                         Opacity="0.6"/>
                                <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                                         FontWeight="Bold" Margin="0 4 0 16">
                                    <Run Text="{Binding SelectedSale.Customer.FirstName}"/>
                                    <Run Text="{Binding SelectedSale.Customer.LastName}"/>
                                </TextBlock>
                                
                                <TextBlock Text="İŞLEM TARİHİ" 
                                         Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                         Opacity="0.6"/>
                                <TextBlock Text="{Binding SelectedSale.CreatedDate, StringFormat='{}{0:dd MMMM yyyy, HH:mm}'}" 
                                         Style="{StaticResource MaterialDesignBody2TextBlock}" 
                                         Margin="0 4 0 0"/>
                            </StackPanel>
                            
                            <!-- Divider 1 -->
                            <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource MaterialDesignDivider}" Margin="16 0"/>

                            <!-- Column 2: Payment Info -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ÖDEME YÖNTEMİ" 
                                         Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                         Opacity="0.6"/>
                                <StackPanel Orientation="Horizontal" Margin="0 4 0 16">
                                    <materialDesign:PackIcon Kind="CreditCardOutline" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                        <TextBlock.Text>
                                            <Binding Path="SelectedSale.PaymentMethod">
                                                <Binding.Converter>
                                                    <converters:PaymentMethodConverter/>
                                                </Binding.Converter>
                                            </Binding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                
                                <TextBlock Text="İŞLEM TÜRÜ" 
                                         Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                         Opacity="0.6"/>
                                <materialDesign:Chip Margin="0 4 0 0" FontSize="12" Padding="8 4">
                                     <materialDesign:Chip.Content>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <Binding Path="SelectedSale.PaymentType">
                                                    <Binding.Converter>
                                                        <converters:PaymentTypeConverter/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                     </materialDesign:Chip.Content>
                                </materialDesign:Chip>
                            </StackPanel>

                            <!-- Divider 2 -->
                            <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource MaterialDesignDivider}" Margin="16 0"/>

                            <!-- Column 3: Financials -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="TOPLAM TUTAR" 
                                         Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                         Opacity="0.6"/>
                                <TextBlock Text="{Binding SelectedSale.TotalAmount, StringFormat='{}{0:N2} TL'}" 
                                         Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                         FontWeight="Bold"
                                         Margin="0 4 0 0"/>
                                         
                                <Grid Margin="0 16 0 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ödenen" FontSize="11" Opacity="0.6"/>
                                        <TextBlock Text="{Binding SelectedSale.PaidAmount, StringFormat='{}{0:N2} TL'}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Kalan" FontSize="11" Opacity="0.6"/>
                                        <TextBlock Text="{Binding SelectedSale.RemainingAmount, StringFormat='{}{0:N2} TL'}"
                                                 Foreground="Red" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                    
                    <!-- Sale Items -->
                    <Border Grid.Row="2" Margin="24 0 24 16" 
                            BorderThickness="1" 
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            CornerRadius="4">
                        <DataGrid ItemsSource="{Binding SelectedSale.PaymentItems}"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                HeadersVisibility="All"
                                CanUserSortColumns="True"
                                BorderThickness="0"
                                materialDesign:DataGridAssist.CellPadding="16 8 8 8"
                                materialDesign:DataGridAssist.ColumnHeaderPadding="16 8 8 8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ürün Adı" 
                                                  Binding="{Binding Product.Name}"
                                                  Width="2*"
                                                  ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                                  
                                <DataGridTextColumn Header="Miktar" 
                                                  Binding="{Binding Quantity}"
                                                  Width="Auto"
                                                  ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>

                                <DataGridTemplateColumn Header="İade" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RefundedQuantity, StringFormat='{}{0} Adet'}" 
                                                       Foreground="Red" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RefundedQuantity}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                                  
                                <DataGridTextColumn Header="Birim Fiyat" 
                                                  Binding="{Binding UnitPrice, StringFormat='{}{0:N2} TL'}"
                                                  Width="*"
                                                  ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                                  
                                <DataGridTextColumn Header="Toplam" 
                                                  Binding="{Binding TotalPrice, StringFormat='{}{0:N2} TL'}"
                                                  Width="*"
                                                  FontWeight="Bold"
                                                  ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    
                    <!-- Close Button -->
                    <Border Grid.Row="3" Padding="24" Background="{DynamicResource MaterialDesignPaper}">
                        <Button Command="{Binding CloseSaleDetailsCommand}"
                              Content="Kapat"
                              Style="{StaticResource MaterialDesignFlatButton}"
                              HorizontalAlignment="Right"/>
                    </Border>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
        
        <!-- Partial Payment Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3" 
                                 IsOpen="{Binding IsPartialPaymentDialogOpen}" 
                                 CloseOnClickAway="False">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="400" MinHeight="250">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Dialog Title -->
                    <TextBlock Grid.Row="0" 
                             Text="Ödeme Yap" 
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Margin="16 16 16 16"/>
                    
                    <!-- Customer Info -->
                    <StackPanel Grid.Row="1" Margin="16 0 16 16">
                        <TextBlock Text="Müşteri" 
                                 FontSize="12" 
                                 Opacity="0.7"/>
                        <TextBlock FontWeight="Bold" 
                                 FontSize="16">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="SelectedSale.Customer.FirstName" />
                                    <Binding Path="SelectedSale.Customer.LastName" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    
                    <!-- Payment Details -->
                    <Grid Grid.Row="2" Margin="16 0 16 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Total Amount -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Toplam Tutar" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBlock Text="{Binding SelectedSale.TotalAmount, StringFormat='{}{0:N2} TL'}" 
                                     FontWeight="Bold" 
                                     FontSize="16"/>
                        </StackPanel>
                        
                        <!-- Remaining Amount -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Kalan Tutar" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBlock Text="{Binding SelectedSale.RemainingAmount, StringFormat='{}{0:N2} TL'}" 
                                     FontWeight="Bold" 
                                     FontSize="16"
                                     Foreground="Red"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Payment Input -->
                    <StackPanel Grid.Row="3" Margin="16 0 16 16">
                        <TextBlock Text="Ödeme Tutarı" 
                                 FontSize="12" 
                                 Opacity="0.7"/>
                        <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                               materialDesign:HintAssist.Hint="Ödeme Tutarı"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>
                    
                    <!-- Buttons -->
                    <StackPanel Grid.Row="4" 
                              Orientation="Horizontal" 
                              HorizontalAlignment="Right" 
                              Margin="16">
                        <Button Command="{Binding CancelPartialPaymentCommand}"
                              Content="İptal"
                              Style="{StaticResource MaterialDesignOutlinedButton}"
                              Margin="0 0 8 0"/>
                        
                        <Button Command="{Binding MakePartialPaymentCommand}"
                              Content="Ödeme Yap"
                              Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
        
        <!-- Product History Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3" 
                                 IsOpen="{Binding IsProductHistoryDialogOpen}" 
                                 CloseOnClickAway="False">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="700" MinHeight="400">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Dialog Title -->
                    <TextBlock Grid.Row="0" 
                             Text="{Binding SelectedHistoryProduct.Name, StringFormat=Ürün Geçmişi: {0}}" 
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Margin="16 16 16 8"/>
                    
                    <!-- Product Info -->
                    <Grid Grid.Row="1" Margin="16 0 16 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Barcode -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Barkod" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBlock Text="{Binding SelectedHistoryProduct.Barcode}" 
                                     FontWeight="Bold" 
                                     FontSize="14"/>
                        </StackPanel>
                        
                        <!-- Price -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Fiyat" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBlock Text="{Binding SelectedHistoryProduct.Price, StringFormat='{}{0:N2} TL'}" 
                                     FontWeight="Bold" 
                                     FontSize="14"/>
                        </StackPanel>
                        
                        <!-- Stock -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Stok" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBlock Text="{Binding SelectedHistoryProduct.StockQuantity}" 
                                     FontWeight="Bold" 
                                     FontSize="14"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Sales History -->
                    <DataGrid Grid.Row="2" 
                            ItemsSource="{Binding ProductSaleHistory}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            Margin="16 0 16 16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarih" 
                                              Binding="{Binding CreatedDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                              Width="*"/>
                            <DataGridTextColumn Header="Müşteri" 
                                              Width="*">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="Customer.FirstName" />
                                        <Binding Path="Customer.LastName" />
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Miktar" 
                                              Binding="{Binding PaymentItems[0].Quantity}"
                                              Width="*"/>
                            <DataGridTextColumn Header="Birim Fiyat" 
                                              Binding="{Binding PaymentItems[0].UnitPrice, StringFormat='{}{0:N2} TL'}"
                                              Width="*"/>
                            <DataGridTextColumn Header="Toplam" 
                                              Binding="{Binding PaymentItems[0].TotalPrice, StringFormat='{}{0:N2} TL'}"
                                              Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- Buttons -->
                    <StackPanel Grid.Row="3" 
                              Orientation="Horizontal" 
                              HorizontalAlignment="Right" 
                              Margin="16">
                        <Button Command="{Binding CloseProductHistoryCommand}"
                              Content="Kapat"
                              Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
        
        <!-- Payment History Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3" 
                                 IsOpen="{Binding IsPaymentHistoryDialogOpen}" 
                                 CloseOnClickAway="False">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="700" MinHeight="400">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Dialog Title -->
                    <TextBlock Grid.Row="0" 
                             Text="Ödeme Geçmişi" 
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Margin="16 16 16 8"/>
                    
                    <!-- Payment Info -->
                    <Grid Grid.Row="1" Margin="16 0 16 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Customer -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Müşteri" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBlock FontWeight="Bold" 
                                     FontSize="14">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="SelectedSale.Customer.FirstName" />
                                        <Binding Path="SelectedSale.Customer.LastName" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        
                        <!-- Total Amount -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Toplam Tutar" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBlock Text="{Binding SelectedSale.TotalAmount, StringFormat='{}{0:N2} TL'}" 
                                     FontWeight="Bold" 
                                     FontSize="14"/>
                        </StackPanel>
                        
                        <!-- Paid Amount -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ödenen Tutar" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBlock Text="{Binding SelectedSale.PaidAmount, StringFormat='{}{0:N2} TL'}" 
                                     FontWeight="Bold" 
                                     FontSize="14"/>
                        </StackPanel>
                        
                        <!-- Remaining Amount -->
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Kalan Tutar" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBlock Text="{Binding SelectedSale.RemainingAmount, StringFormat='{}{0:N2} TL'}" 
                                     FontWeight="Bold" 
                                     FontSize="14"
                                     Foreground="Red"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Transactions -->
                    <DataGrid Grid.Row="2" 
                            ItemsSource="{Binding PaymentTransactions}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            Margin="16 0 16 16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarih" 
                                              Binding="{Binding TransactionDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                              Width="*"/>
                            <DataGridTextColumn Header="İşlem Tipi" 
                                              Binding="{Binding Type}"
                                              Width="*"/>
                            <DataGridTextColumn Header="Tutar" 
                                              Binding="{Binding Amount, StringFormat='{}{0:N2} TL'}"
                                              Width="*"/>
                            <DataGridTextColumn Header="Açıklama" 
                                              Binding="{Binding Description}"
                                              Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- Buttons -->
                    <StackPanel Grid.Row="3" 
                              Orientation="Horizontal" 
                              HorizontalAlignment="Right" 
                              Margin="16">
                        <Button Command="{Binding ClosePaymentHistoryCommand}"
                              Content="Kapat"
                              Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </StackPanel>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
    </Grid>
</UserControl> 