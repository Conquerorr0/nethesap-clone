<UserControl x:Class="Nethesap.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Nethesap.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Margin="32" Width="400">
        <TextBlock Text="Ayarlar" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0 0 0 24"/>
        <TextBox Margin="0 0 0 16" 
                 materialDesign:HintAssist.Hint="Firma Adı"
                 Text="{Binding CompanyName, FallbackValue=Demo Şirket}"/>
        <TextBox Margin="0 0 0 16" 
                 materialDesign:HintAssist.Hint="E-posta"
                 Text="{Binding Email, FallbackValue=info@demo.com}"/>
        <PasswordBox Margin="0 0 0 16" 
                     materialDesign:HintAssist.Hint="Şifre"/>
        <Button Content="Kaydet" Style="{StaticResource MaterialDesignRaisedButton}" Width="120" HorizontalAlignment="Right"/>
    </StackPanel>
</UserControl> 