<UserControl x:Class="Nethesap.UI.Views.CustomerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Nethesap.UI.Views"
             xmlns:converters="clr-namespace:Nethesap.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:BalanceToColorConverter x:Key="BalanceToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0 0 0 16">
            <Button DockPanel.Dock="Left" 
                    Command="{Binding BackCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Geri Dön">
                <materialDesign:PackIcon Kind="ArrowLeft"/>
            </Button>
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16 0 0 0">
                <TextBlock Text="{Binding Customer.FirstName}" 
                         Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                         FontWeight="Bold"/>
                <TextBlock Text=" " Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
                <TextBlock Text="{Binding Customer.LastName}" 
                         Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                         FontWeight="Bold"/>
                <TextBlock Text=" - Detaylar" 
                         Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                         Opacity="0.7"/>
            </StackPanel>
            
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                 <TextBlock Text="Güncel Bakiye: " 
                          Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                          VerticalAlignment="Center"/>
                 <TextBlock Text="{Binding CurrentBalance, StringFormat={}{0:C2}}" 
                          Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                          Foreground="{Binding CurrentBalance, Converter={StaticResource BalanceToColorConverter}}"
                          FontWeight="Bold"
                          VerticalAlignment="Center"
                          Margin="8 0 0 0"/>
            </StackPanel>
        </DockPanel>

        <!-- Filters -->
        <materialDesign:Card Grid.Row="1" Margin="0 0 0 16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="İşlem ara..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0 0 16 0"/>

                <DatePicker Grid.Column="1"
                          SelectedDate="{Binding StartDate}"
                          materialDesign:HintAssist.Hint="Başlangıç Tarihi"
                          Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                          Margin="0 0 16 0"
                          Width="150"/>

                <DatePicker Grid.Column="2"
                          SelectedDate="{Binding EndDate}"
                          materialDesign:HintAssist.Hint="Bitiş Tarihi"
                          Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                          Width="150"/>
            </Grid>
        </materialDesign:Card>

        <!-- Transactions List -->
        <materialDesign:Card Grid.Row="2" VerticalAlignment="Stretch">
            <ListView ItemsSource="{Binding FilteredTransactions}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Tarih" DisplayMemberBinding="{Binding TransactionDate, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                        <GridViewColumn Header="Açıklama" DisplayMemberBinding="{Binding Description}" Width="250"/>
                        <GridViewColumn Header="Tutar" DisplayMemberBinding="{Binding Amount, StringFormat=C2}" Width="120"/>
                        <GridViewColumn Header="İşlem Tipi" DisplayMemberBinding="{Binding Type}" Width="100"/>
                        <GridViewColumn Header="Detaylar" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ViewSaleDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="32"
                                            Padding="16,4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="InformationOutline" 
                                                                   Width="16" 
                                                                   Height="16" 
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,4,0"/>
                                            <TextBlock Text="Detaylar" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </materialDesign:Card>

        <!-- Sale Details Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3" 
                                 IsOpen="{Binding IsSaleDetailsDialogOpen}"
                                 CloseOnClickAway="True">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="600" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Satış Detayları" 
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Margin="0 0 0 16"/>

                    <!-- Sale Summary -->
                    <materialDesign:Card Grid.Row="1" Padding="16" Margin="0 0 0 16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tarih:" FontWeight="Bold" Margin="0 0 0 8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSale.CreatedDate, StringFormat=dd.MM.yyyy HH:mm}" Margin="0 0 0 8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Toplam Tutar:" FontWeight="Bold" Margin="0 0 0 8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSale.TotalAmount, StringFormat=C2}" Margin="0 0 0 8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ödenen:" FontWeight="Bold" Margin="0 0 0 8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSale.PaidAmount, StringFormat=C2}" Margin="0 0 0 8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Kalan:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSale.RemainingAmount, StringFormat=C2}" Foreground="Red"/>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Products List -->
                    <materialDesign:Card Grid.Row="2" Margin="0 0 0 16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding SelectedSale.PaymentItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                              BorderThickness="0 0 0 1" 
                                              Padding="16 8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" 
                                                         Text="{Binding Product.Name}" 
                                                         VerticalAlignment="Center"
                                                         FontWeight="Medium"/>
                                                
                                                <TextBlock Grid.Column="1" 
                                                         Text="{Binding Quantity, StringFormat='x{0}'}" 
                                                         VerticalAlignment="Center"
                                                         Margin="16 0"
                                                         Opacity="0.7"/>
                                                
                                                <TextBlock Grid.Column="2" 
                                                         Text="{Binding UnitPrice, StringFormat=C2}" 
                                                         VerticalAlignment="Center"
                                                         Margin="16 0"
                                                         Opacity="0.7"/>
                                                
                                                <TextBlock Grid.Column="3" 
                                                         Text="{Binding TotalPrice, StringFormat=C2}" 
                                                         VerticalAlignment="Center"
                                                         FontWeight="Bold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </materialDesign:Card>

                    <!-- Payment Info -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0 0 0 16">
                        <materialDesign:PackIcon Kind="CreditCard" VerticalAlignment="Center" Margin="0 0 8 0"/>
                        <TextBlock Text="Ödeme Yöntemi: " VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedSale.PaymentMethod}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Row="4" 
                            Command="{Binding CloseSaleDetailsCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="Kapat"
                            HorizontalAlignment="Right"/>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
    </Grid>
</UserControl>
