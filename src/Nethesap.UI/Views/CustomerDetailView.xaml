<UserControl x:Class="Nethesap.UI.Views.CustomerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Nethesap.UI.Views"
             xmlns:converters="clr-namespace:Nethesap.UI.Converters"
             xmlns:viewModels="clr-namespace:Nethesap.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=viewModels:CustomerDetailViewModel}">
    <UserControl.Resources>
        <converters:BalanceToColorConverter x:Key="BalanceToColorConverter"/>
        <converters:PaymentMethodConverter x:Key="PaymentMethodConverter"/>
        <converters:PaymentTypeConverter x:Key="PaymentTypeConverter"/>
        <converters:PaymentTypeToVisibilityConverter x:Key="PaymentTypeToVisibilityConverter"/>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <converters:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0 0 0 16">
            <Button DockPanel.Dock="Left" 
                    Command="{Binding BackCommand}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="Geri Dön">
                <materialDesign:PackIcon Kind="ArrowLeft"/>
            </Button>
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16 0 0 0">
                <TextBlock Text="{Binding Customer.FirstName}" 
                         Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                         FontWeight="Bold"/>
                <TextBlock Text=" " Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
                <TextBlock Text="{Binding Customer.LastName}" 
                         Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                         FontWeight="Bold"/>
                <TextBlock Text=" - Detaylar" 
                         Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                         Opacity="0.7"/>
            </StackPanel>
            
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                 <TextBlock Text="Güncel Bakiye: " 
                          Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                          VerticalAlignment="Center"/>
                 <TextBlock Text="{Binding CurrentBalance, StringFormat='{}{0:N2} TL'}" 
                          Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                          Foreground="{Binding CurrentBalance, Converter={StaticResource BalanceToColorConverter}}"
                          FontWeight="Bold"
                          VerticalAlignment="Center"
                          Margin="8 0 0 0"/>
            </StackPanel>
        </DockPanel>

        <!-- Filters -->
        <materialDesign:Card Grid.Row="1" Margin="0 0 0 16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="İşlem ara..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0 0 16 0"/>

                <DatePicker Grid.Column="1"
                          SelectedDate="{Binding StartDate}"
                          materialDesign:HintAssist.Hint="Başlangıç Tarihi"
                          Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                          Margin="0 0 16 0"
                          Width="150"/>

                <DatePicker Grid.Column="2"
                          SelectedDate="{Binding EndDate}"
                          materialDesign:HintAssist.Hint="Bitiş Tarihi"
                          Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                          Width="150"/>
            </Grid>
        </materialDesign:Card>

        <!-- Transactions (Sales) DataGrid - Matches SalesView.xaml -->
        <materialDesign:Card Grid.Row="2" UniformCornerRadius="4">
            <DataGrid ItemsSource="{Binding FilteredSales}"
                      SelectedItem="{Binding SelectedSale}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                <DataGrid.Columns>
                    <!-- Customer column removed as we are in customer detail -->
                    <DataGridTextColumn Header="Tarih" 
                                      Binding="{Binding CreatedDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                      Width="*"/>
                    <DataGridTextColumn Header="Ödeme Yöntemi" 
                                      Width="*">
                        <DataGridTextColumn.Binding>
                            <Binding Path="PaymentMethod">
                                <Binding.Converter>
                                    <converters:PaymentMethodConverter/>
                                </Binding.Converter>
                            </Binding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tür"
                                      Width="*">
                        <DataGridTextColumn.Binding>
                            <Binding Path="PaymentType">
                                <Binding.Converter>
                                    <converters:PaymentTypeConverter/>
                                </Binding.Converter>
                            </Binding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tutar" 
                                      Binding="{Binding TotalAmount, StringFormat='{}{0:N2} TL'}"
                                      Width="*"/>
                    <DataGridTextColumn Header="Ödenen" 
                                      Binding="{Binding PaidAmount, StringFormat='{}{0:N2} TL'}"
                                      Width="*"/>
                    <DataGridTextColumn Header="Kalan" 
                                      Binding="{Binding RemainingAmount, StringFormat='{}{0:N2} TL'}"
                                      Width="*"/>
                                      
                    <!-- Action Buttons -->
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenPartialPaymentDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}"
                                      ToolTip="Ödeme Yap">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RemainingAmount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="CashMultiple" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ViewPaymentHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}"
                                      Style="{StaticResource MaterialDesignIconButton}"
                                      ToolTip="Ödeme Geçmişi">
                                    <materialDesign:PackIcon Kind="History" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.RefundSaleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}"
                                      Style="{StaticResource MaterialDesignIconButton}"
                                      ToolTip="İade Et"
                                      Visibility="{Binding PaymentType, Converter={StaticResource PaymentTypeToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="CartRemove" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ViewSaleDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}"
                                      Style="{StaticResource MaterialDesignIconButton}"
                                      ToolTip="Detaylar">
                                    <materialDesign:PackIcon Kind="Information" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- Sale Details Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3" 
                                 IsOpen="{Binding IsSaleDetailsDialogOpen}" 
                                 CloseOnClickAway="True">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="700" MinHeight="400">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Dialog Title -->
                    <TextBlock Grid.Row="0" 
                             Text="Satış Detayları" 
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Margin="16 16 16 16"/>
                    
                    <!-- Sale Information -->
                    <Grid Grid.Row="1" Margin="16 0 16 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Müşteri -->
                        <TextBlock Grid.Row="0" Grid.Column="0" 
                                 Text="Müşteri:" 
                                 FontWeight="Bold"
                                 Margin="0 0 8 8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                 Margin="0 0 16 8">
                            <Run Text="{Binding SelectedSale.Customer.FirstName}"/>
                            <Run Text="{Binding SelectedSale.Customer.LastName}"/>
                        </TextBlock>
                        
                        <!-- Tarih -->
                        <TextBlock Grid.Row="0" Grid.Column="2" 
                                 Text="Tarih:" 
                                 FontWeight="Bold"
                                 Margin="0 0 8 8"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" 
                                 Text="{Binding SelectedSale.CreatedDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" 
                                 Margin="0 0 0 8"/>
                        
                        <!-- Ödeme Yöntemi -->
                        <TextBlock Grid.Row="1" Grid.Column="0" 
                                 Text="Ödeme Yöntemi:" 
                                 FontWeight="Bold"
                                 Margin="0 0 8 8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                 Margin="0 0 16 8">
                            <TextBlock.Text>
                                <Binding Path="SelectedSale.PaymentMethod">
                                    <Binding.Converter>
                                        <converters:PaymentMethodConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Text>
                        </TextBlock>
                        
                        <!-- Ödeme Türü -->
                        <TextBlock Grid.Row="1" Grid.Column="2" 
                                 Text="Ödeme Türü:" 
                                 FontWeight="Bold"
                                 Margin="0 0 8 8"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" 
                                 Margin="0 0 0 8">
                            <TextBlock.Text>
                                <Binding Path="SelectedSale.PaymentType">
                                    <Binding.Converter>
                                        <converters:PaymentTypeConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Text>
                        </TextBlock>
                        
                        <!-- Toplam Tutar -->
                        <TextBlock Grid.Row="2" Grid.Column="0" 
                                 Text="Toplam Tutar:" 
                                 FontWeight="Bold"
                                 Margin="0 0 8 8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" 
                                 Text="{Binding SelectedSale.TotalAmount, StringFormat='{}{0:N2} TL'}" 
                                 Margin="0 0 16 8"/>
                    </Grid>
                    
                    <!-- Sale Items -->
                    <DataGrid Grid.Row="2" 
                            ItemsSource="{Binding SelectedSale.PaymentItems}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            Margin="16 0 16 16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ürün" 
                                              Binding="{Binding Product.Name}"
                                              Width="*"/>
                            <DataGridTextColumn Header="Miktar" 
                                              Binding="{Binding Quantity}"
                                              Width="Auto"/>
                            <DataGridTextColumn Header="Birim Fiyat" 
                                              Binding="{Binding UnitPrice, StringFormat='{}{0:N2} TL'}"
                                              Width="Auto"/>
                            <DataGridTextColumn Header="Toplam" 
                                              Binding="{Binding TotalPrice, StringFormat='{}{0:N2} TL'}"
                                              Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- Close Button -->
                    <Button Grid.Row="3" 
                          Command="{Binding CloseSaleDetailsCommand}"
                          Content="Kapat"
                          Style="{StaticResource MaterialDesignFlatButton}"
                          HorizontalAlignment="Right"
                          Margin="16"/>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- Partial Payment Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3" 
                                 IsOpen="{Binding IsPartialPaymentDialogOpen}" 
                                 CloseOnClickAway="False">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="400" MinHeight="250">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Dialog Title -->
                    <TextBlock Grid.Row="0" 
                             Text="Ödeme Yap" 
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Margin="16 16 16 16"/>
                    
                    <!-- Customer Info -->
                    <StackPanel Grid.Row="1" Margin="16 0 16 16">
                        <TextBlock Text="Müşteri" 
                                 FontSize="12" 
                                 Opacity="0.7"/>
                        <TextBlock FontWeight="Bold" 
                                 FontSize="16">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="SelectedSale.Customer.FirstName" />
                                    <Binding Path="SelectedSale.Customer.LastName" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    
                    <!-- Payment Details -->
                    <Grid Grid.Row="2" Margin="16 0 16 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Total Amount -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Toplam Tutar" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBlock Text="{Binding SelectedSale.TotalAmount, StringFormat='{}{0:N2} TL'}" 
                                     FontWeight="Bold" 
                                     FontSize="16"/>
                        </StackPanel>
                        
                        <!-- Remaining Amount -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Kalan Tutar" 
                                     FontSize="12" 
                                     Opacity="0.7"/>
                            <TextBlock Text="{Binding SelectedSale.RemainingAmount, StringFormat='{}{0:N2} TL'}" 
                                     FontWeight="Bold" 
                                     FontSize="16"
                                     Foreground="Red"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Payment Input -->
                    <StackPanel Grid.Row="3" Margin="16 0 16 16">
                        <TextBlock Text="Ödeme Tutarı" 
                                 FontSize="12" 
                                 Opacity="0.7"/>
                        <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                               materialDesign:HintAssist.Hint="Ödeme Tutarı"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>
                    
                    <!-- Buttons -->
                    <StackPanel Grid.Row="4" 
                              Orientation="Horizontal" 
                              HorizontalAlignment="Right" 
                              Margin="16">
                        <Button Command="{Binding CancelPartialPaymentCommand}"
                              Style="{StaticResource MaterialDesignOutlinedButton}"
                              Content="İptal"
                              Margin="0 0 8 0"/>
                        
                        <Button Command="{Binding MakePartialPaymentCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="Ödeme Al"/>
                    </StackPanel>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- Payment History Dialog -->
         <materialDesign:DialogHost Grid.RowSpan="3" 
                                  IsOpen="{Binding IsPaymentHistoryDialogOpen}" 
                                  CloseOnClickAway="True">
             <materialDesign:DialogHost.DialogContent>
                 <Grid Width="900" MinHeight="500">
                     <Grid.RowDefinitions>
                         <RowDefinition Height="Auto"/>
                         <RowDefinition Height="Auto"/>
                         <RowDefinition Height="*"/>
                         <RowDefinition Height="Auto"/>
                     </Grid.RowDefinitions>
                     
                     <!-- Header -->
                     <DockPanel Grid.Row="0" Margin="24 24 24 16">
                         <TextBlock Text="Ödeme Geçmişi" 
                                  Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"/>
                                  
                         <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                             <materialDesign:Chip Content="{Binding SelectedSale.PaymentType}" 
                                                IconBackground="{StaticResource PrimaryHueMidBrush}"
                                                IconForeground="{StaticResource PrimaryHueMidForegroundBrush}"
                                                Margin="0 0 8 0">
                                 <materialDesign:Chip.Icon>
                                     <materialDesign:PackIcon Kind="Tag" />
                                 </materialDesign:Chip.Icon>
                             </materialDesign:Chip>
                             
                             <materialDesign:Chip Content="{Binding SelectedSale.CreatedDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                                IconBackground="{StaticResource SecondaryHueMidBrush}"
                                                IconForeground="{StaticResource SecondaryHueMidForegroundBrush}">
                                 <materialDesign:Chip.Icon>
                                     <materialDesign:PackIcon Kind="Calendar" />
                                 </materialDesign:Chip.Icon>
                             </materialDesign:Chip>
                         </StackPanel>
                     </DockPanel>
                     
                     <!-- Summary Card -->
                     <materialDesign:Card Grid.Row="1" Margin="24 0 24 16" Padding="16" Background="{DynamicResource MaterialDesignPaper}">
                         <Grid>
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="Auto"/> <!-- Divider -->
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="Auto"/> <!-- Divider -->
                                 <ColumnDefinition Width="*"/>
                             </Grid.ColumnDefinitions>
                             
                             <!-- Total Amount -->
                             <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                 <TextBlock Text="TOPLAM TUTAR" 
                                          Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                          Opacity="0.6"
                                          HorizontalAlignment="Center"/>
                                 <TextBlock Text="{Binding SelectedSale.TotalAmount, StringFormat='{}{0:C2}'}" 
                                          Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"/>
                             </StackPanel>
                             
                             <Border Grid.Column="1" Width="1" Background="{DynamicResource MaterialDesignDivider}" Margin="8 0"/>
                             
                             <!-- Paid Amount -->
                             <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                 <TextBlock Text="ÖDENEN TUTAR" 
                                          Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                          Opacity="0.6"
                                          HorizontalAlignment="Center"/>
                                 <TextBlock Text="{Binding SelectedSale.PaidAmount, StringFormat='{}{0:C2}'}" 
                                          Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                          Foreground="Green"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"/>
                             </StackPanel>
                             
                             <Border Grid.Column="3" Width="1" Background="{DynamicResource MaterialDesignDivider}" Margin="8 0"/>
                             
                             <!-- Remaining Amount -->
                             <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                 <TextBlock Text="KALAN TUTAR" 
                                          Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                                          Opacity="0.6"
                                          HorizontalAlignment="Center"/>
                                 <TextBlock Text="{Binding SelectedSale.RemainingAmount, StringFormat='{}{0:C2}'}" 
                                          Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                          Foreground="Red"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"/>
                             </StackPanel>
                         </Grid>
                     </materialDesign:Card>
                              
                     <!-- Transactions Grid -->
                     <DataGrid Grid.Row="2"
                             ItemsSource="{Binding SelectedSale.Transactions}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             CanUserSortColumns="True"
                             HeadersVisibility="All"
                             Margin="24 0 24 0"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource MaterialDesignDivider}">
                         <DataGrid.Columns>
                             <DataGridTextColumn Header="Tarih" 
                                               Binding="{Binding TransactionDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}" 
                                               Width="150"/>
                             <DataGridTextColumn Header="Açıklama" 
                                               Binding="{Binding Description}" 
                                               Width="*"/>
                             <DataGridTextColumn Header="Tutar" 
                                               Binding="{Binding Amount, StringFormat={}{0:C2}}" 
                                               Width="120"
                                               ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                             <DataGridTextColumn Header="İşlem Tipi" 
                                               Binding="{Binding Type}" 
                                               Width="120"/>
                         </DataGrid.Columns>
                     </DataGrid>
                     
                     <Button Grid.Row="3"
                           Command="{Binding ClosePaymentHistoryCommand}"
                           Content="Kapat"
                           Style="{StaticResource MaterialDesignFlatButton}"
                           HorizontalAlignment="Right"
                           Margin="24"/>
                 </Grid>
             </materialDesign:DialogHost.DialogContent>
         </materialDesign:DialogHost>

        <!-- Refund Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3"
                                 IsOpen="{Binding IsRefundDialogOpen}"
                                 CloseOnClickAway="False">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="400" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0"
                             Text="Satış İadesi"
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Margin="0 0 0 16"/>
                    
                    <TextBlock Grid.Row="1"
                             Margin="0 0 0 16">
                        <Run Text="Müşteri: "/>
                        <Run Text="{Binding SelectedSale.Customer.FirstName}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding SelectedSale.Customer.LastName}"/>
                    </TextBlock>
                    
                    <TextBlock Grid.Row="2"
                             Margin="0 0 0 16">
                        <Run Text="İade Tutarı: "/>
                        <Run Text="{Binding SelectedSale.TotalAmount, StringFormat='{}{0:N2} TL'}" FontWeight="Bold"/>
                    </TextBlock>
                    
                    <StackPanel Grid.Row="3"
                              Orientation="Horizontal"
                              HorizontalAlignment="Right">
                        <Button Command="{Binding CancelRefundCommand}"
                              Style="{StaticResource MaterialDesignOutlinedButton}"
                              Content="İptal"
                              Margin="0 0 8 0"/>
                        
                        <Button Command="{Binding ProcessRefundCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="İade Et"/>
                    </StackPanel>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

    </Grid>
</UserControl>
