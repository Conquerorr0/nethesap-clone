<UserControl x:Class="Nethesap.UI.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Nethesap.UI.Views"
             xmlns:converters="clr-namespace:Nethesap.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:BalanceToColorConverter x:Key="BalanceToColorConverter"/>
    </UserControl.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Title and Add Button -->
        <DockPanel Grid.Row="0" Margin="0 0 0 16">
            <Button DockPanel.Dock="Right"
                    Command="{Binding AddCustomerCommand}"
                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                    Background="{StaticResource PrimaryHueDarkBrush}"
                    BorderBrush="{StaticResource PrimaryHueDarkBrush}"
                    ToolTip="Yeni Müşteri Ekle">
                <materialDesign:PackIcon Kind="Plus" Height="24" Width="24"/>
            </Button>
            <TextBlock Text="Müşteriler"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="0 0 0 16">
            <materialDesign:Card Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <materialDesign:PackIcon Kind="Search" 
                                           Grid.Column="0" 
                                           VerticalAlignment="Center"
                                           Margin="8 0 8 0"/>
                    
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Müşteri ara..."
                             Style="{StaticResource MaterialDesignTextBox}"
                             VerticalAlignment="Center"
                             Margin="0 8 8 8"
                             BorderThickness="0"/>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Customer Cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredCustomers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Margin="0 0 0 16" Padding="16" UniformCornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Customer Name -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                          Text="{Binding FirstName, StringFormat='{}{0} '}"
                                          Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                          FontWeight="Bold">
                                    <TextBlock.Inlines>
                                        <Run Text="{Binding LastName}"/>
                                    </TextBlock.Inlines>
                                </TextBlock>
                                
                                <!-- Contact Info -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0 8 0 0">
                                    <materialDesign:PackIcon Kind="Phone" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                    <TextBlock Text="{Binding Phone}" VerticalAlignment="Center"/>
                                    
                                    <materialDesign:PackIcon Kind="Email" VerticalAlignment="Center" Margin="16 0 8 0"/>
                                    <TextBlock Text="{Binding Email}" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Balance -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" 
                                           VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="Bakiye Durumu" 
                                             HorizontalAlignment="Center" 
                                             FontSize="12" 
                                             Opacity="0.7"/>
                                    <TextBlock Text="{Binding Balance, StringFormat='{}{0:N2} TL'}" 
                                             FontWeight="Bold" 
                                             FontSize="18"
                                             HorizontalAlignment="Center"
                                             Foreground="{Binding Balance, Converter={StaticResource BalanceToColorConverter}}"/>
                                </StackPanel>
                                
                                <!-- Transaction History Button -->
                                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Command="{Binding DataContext.ShowTransactionHistoryCommand, 
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}"
                                       Margin="0 16 0 0"
                                       Style="{StaticResource MaterialDesignOutlinedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="History" Margin="0 0 8 0"/>
                                        <TextBlock Text="Geçmiş İşlemler"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Add Customer Dialog -->
        <materialDesign:DialogHost Grid.RowSpan="3" 
                                 IsOpen="{Binding IsAddDialogOpen}" 
                                 CloseOnClickAway="True">
            <materialDesign:DialogHost.DialogContent>
                <Grid Width="400" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                             Text="Yeni Müşteri Ekle" 
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Margin="0 0 0 16"/>

                    <TextBox Grid.Row="1"
                           Text="{Binding NewCustomer.FirstName}"
                           materialDesign:HintAssist.Hint="Ad"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           Margin="0 0 0 8"/>

                    <TextBox Grid.Row="2"
                           Text="{Binding NewCustomer.LastName}"
                           materialDesign:HintAssist.Hint="Soyad"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           Margin="0 0 0 8"/>

                    <TextBox Grid.Row="3"
                           Text="{Binding NewCustomer.Phone}"
                           materialDesign:HintAssist.Hint="Telefon"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           Margin="0 0 0 8"/>

                    <TextBox Grid.Row="4"
                           Text="{Binding NewCustomer.Email}"
                           materialDesign:HintAssist.Hint="E-posta"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           Margin="0 0 0 8"/>

                    <TextBox Grid.Row="5"
                           Text="{Binding NewCustomer.Address}"
                           materialDesign:HintAssist.Hint="Adres"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           Margin="0 0 0 16"/>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelAddCommand}"
                              Style="{StaticResource MaterialDesignOutlinedButton}"
                              Content="İptal"
                              Margin="0 0 8 0"/>
                        
                        <Button Command="{Binding SaveCustomerCommand}"
                              Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="Kaydet"/>
                    </StackPanel>
                </Grid>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
    </Grid>
</UserControl> 